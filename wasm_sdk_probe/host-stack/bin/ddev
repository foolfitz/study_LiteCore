#!/usr/bin/env bash
# NOT ddev.  Tools bound by evidence call `ddev occ|exec|mysql|describe|list` with cwd = the instance root and may not be edited
# (their bytes are pinned), so this file, first on PATH, is the one adapter between them and this project's own stack.  It picks
# the stack whose *.env STACK_ROOT equals the cwd and refuses anything else, `start` and `stop` included.
#   PATH="$PWD/wasm_sdk_probe/host-stack/bin:$PATH" python3 wasm_sdk_probe/tools/check_m3_assets.py ...
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
stack=$(dirname "$here")
cwd=$(pwd -P)
env_file=""
for f in "$stack"/*.env; do
  root=$(sed -n 's/^STACK_ROOT=//p' "$f")
  if [ "$root" = "$cwd" ]; then env_file=$f; fi
done
if [ -z "$env_file" ]; then
  echo "host-stack/bin/ddev: no stack has STACK_ROOT=$cwd" >&2
  exit 2
fi
set -a; . "$env_file"; set +a
compose() { docker compose --project-directory "$stack" -f "$stack/compose.yaml" --env-file "$env_file" "$@"; }
command=${1:-}
[ $# -gt 0 ] && shift
case "$command" in
  describe)
    [ "${1:-}" = "-j" ] || { echo "only 'describe -j'" >&2; exit 2; }
    printf '{"raw":{"primary_url":"%s","webserver_type":"apache-fpm","name":"%s"}}\n' "$STACK_URL" "$STACK_NAME" ;;
  list)
    [ "${1:-}" = "-j" ] || { echo "only 'list -j'" >&2; exit 2; }
    status=$(compose ps web --format '{{.State}}' 2>/dev/null || true)
    printf '{"raw":[{"name":"%s","status":"%s"}]}\n' "$STACK_LABEL" "${status:-stopped}" ;;
  occ)   exec docker compose --project-directory "$stack" -f "$stack/compose.yaml" --env-file "$env_file" exec -T -w /var/www/html/nextcloud web php occ "$@" ;;
  exec)  exec docker compose --project-directory "$stack" -f "$stack/compose.yaml" --env-file "$env_file" exec -T web "$@" ;;
  mysql) exec docker compose --project-directory "$stack" -f "$stack/compose.yaml" --env-file "$env_file" exec -T db mariadb -udb -pdb db "$@" ;;
  *) echo "host-stack/bin/ddev: '$command' is not an adapter command (this is not ddev)" >&2; exit 2 ;;
esac

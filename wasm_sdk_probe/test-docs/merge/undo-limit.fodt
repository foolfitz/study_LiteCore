<?xml version="1.0" encoding="UTF-8"?>
<!-- Undo-stack readback at the undo limit, fifth round (native, 2026-10-06).
     Run with the user profile's Undo/Steps set to 3.  Delete at the end of
     L01 joins the next one-letter paragraph, the next Delete removes that
     letter, the next joins again: every press is a new undo action (a join
     never folds, and a character delete cannot fold into a join), so the
     stack is full after three presses and stays full. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
 </office:styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Standard">L01</text:p>
   <text:p text:style-name="Standard">b</text:p>
   <text:p text:style-name="Standard">c</text:p>
   <text:p text:style-name="Standard">d</text:p>
   <text:p text:style-name="Standard">e</text:p>
   <text:p text:style-name="Standard">f</text:p>
   <text:p text:style-name="Standard">L07 last</text:p>
  </office:text>
 </office:body>
</office:document>

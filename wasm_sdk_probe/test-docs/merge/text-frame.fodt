<?xml version="1.0" encoding="UTF-8"?>
<!-- Paragraph merge inside a Writer text frame (fly frame), 2026-10-07
     (SPEC-M3-paragraph-merge 18.1 N1).  Inside a fly frame Writer can queue
     TEXT_SELECTION as a normal callback ahead of the flush-time START/END,
     which the E shape's fence depends on; WASM is expected to refuse there
     (anchor-mismatch).  This fixture gives the native reference: F01 Delete
     at the end of the frame's first paragraph, F02 Backspace at the start of
     its second. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
  <style:style style:name="Frame" style:family="graphic">
   <style:graphic-properties style:wrap="none" fo:border="0.06pt solid #000000"/>
  </style:style>
 </office:styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Standard">F00 body before the frame</text:p>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="Frame" draw:name="Frame1" text:anchor-type="paragraph" svg:x="0cm" svg:y="0cm" svg:width="9cm" svg:height="2.5cm" draw:z-index="0"><draw:text-box><text:p text:style-name="Standard">F01 frame first</text:p><text:p text:style-name="Standard">F01 frame second</text:p></draw:text-box></draw:frame>F00 body anchoring the frame</text:p>
   <text:p text:style-name="Standard">F00 body after the frame</text:p>
  </office:text>
 </office:body>
</office:document>

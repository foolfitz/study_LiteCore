<?xml version="1.0" encoding="UTF-8"?>
<!-- Undo-stack readback at the undo limit when every action has the same
     comment, fifth round (native, 2026-10-06).  Run with the user profile's
     Undo/Steps set to 3.  Delete at the end of S01 joins the next empty
     paragraph eight times: every press is a new undo action with the same
     comment, so once the stack is full (press 3) the actions' comments no
     longer change and only their timestamps can.  Presses 9 and 10 are at the
     document's end: nothing changes, with the stack full. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
 </office:styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Standard">S01</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"/>
  </office:text>
 </office:body>
</office:document>

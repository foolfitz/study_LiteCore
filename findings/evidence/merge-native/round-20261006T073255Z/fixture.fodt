<?xml version="1.0" encoding="UTF-8"?>
<!-- Paragraph-merge boundary fixture, second round (native, 2026-10-06).
     The two shapes the first fixture (boundaries.fodt) did not have and the
     owner's PMPC document is made of: headings in an outline whose number
     format is empty (no visible label, as PMPC's "一、序言"), and body
     paragraphs with an indent (PMPC's "First line indent (user)", 0.847cm).
     Writer's Backspace at such a paragraph's start does not merge: it marks a
     heading not counted (NumOrNoNum) and removes an indent (TryRemoveIndent).
     Each anchor occurs exactly once. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
  <style:style style:name="Text_20_body" style:display-name="Text body" style:family="paragraph" style:parent-style-name="Standard" style:class="text">
   <style:paragraph-properties fo:margin-bottom="0.25cm"/>
  </style:style>
  <style:style style:name="First_20_line_20_indent" style:display-name="First line indent" style:family="paragraph" style:parent-style-name="Text_20_body" style:class="text">
   <style:paragraph-properties fo:margin-left="0cm" fo:text-indent="0.847cm" style:auto-text-indent="false"/>
  </style:style>
  <style:style style:name="Left_20_margin" style:display-name="Left margin" style:family="paragraph" style:parent-style-name="Text_20_body" style:class="text">
   <style:paragraph-properties fo:margin-left="1cm" fo:text-indent="0cm"/>
  </style:style>
  <style:style style:name="Hanging_20_indent" style:display-name="Hanging indent" style:family="paragraph" style:parent-style-name="Text_20_body" style:class="text">
   <style:paragraph-properties fo:margin-left="1cm" fo:text-indent="-0.5cm"/>
  </style:style>
  <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:parent-style-name="Standard" style:next-style-name="Text_20_body" style:default-outline-level="1" style:class="text">
   <style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="Heading_20_2" style:display-name="Heading 2" style:family="paragraph" style:parent-style-name="Standard" style:next-style-name="Text_20_body" style:default-outline-level="2" style:class="text">
   <style:text-properties fo:font-size="14pt" fo:font-weight="bold"/>
  </style:style>
  <!-- As PMPC: an empty number format at every level, label followed by a tab. -->
  <text:outline-style style:name="Outline">
   <text:outline-level-style text:level="1" style:num-format="">
    <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
     <style:list-level-label-alignment text:label-followed-by="listtab"/>
    </style:list-level-properties>
   </text:outline-level-style>
   <text:outline-level-style text:level="2" style:num-format="">
    <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
     <style:list-level-label-alignment text:label-followed-by="listtab"/>
    </style:list-level-properties>
   </text:outline-level-style>
  </text:outline-style>
 </office:styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Text_20_body">N01 plain alpha</text:p>
   <text:p text:style-name="Text_20_body">N02 plain beta</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">N03 heading unlabelled</text:h>
   <text:p text:style-name="Text_20_body">N04 body after heading</text:p>
   <text:p text:style-name="Text_20_body">N05 body before heading</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">N06 heading two</text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">N07 subheading</text:h>
   <text:p text:style-name="Text_20_body">N08 plain before indent</text:p>
   <text:p text:style-name="First_20_line_20_indent">N09 first line indented</text:p>
   <text:p text:style-name="First_20_line_20_indent">N10 indented again</text:p>
   <text:p text:style-name="Left_20_margin">N11 left margin</text:p>
   <text:p text:style-name="Hanging_20_indent">N12 hanging indent</text:p>
   <text:p text:style-name="Text_20_body">N13 plain after hanging</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">N14 heading before indent</text:h>
   <text:p text:style-name="First_20_line_20_indent">N15 indented after heading</text:p>
   <text:p text:style-name="Text_20_body">N16 last</text:p>
  </office:text>
 </office:body>
</office:document>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Paragraph-merge boundary fixture (native measurement, 2026-10-06).
     Every boundary kind the shipped selection barrier refuses, each next to an
     anchor that occurs exactly once in the document, so a probe can put the
     caret at one paragraph's end or the next one's start by searching. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
  <style:style style:name="Text_20_body" style:display-name="Text body" style:family="paragraph" style:parent-style-name="Standard" style:class="text">
   <style:paragraph-properties fo:margin-bottom="0.25cm"/>
  </style:style>
  <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:parent-style-name="Standard" style:next-style-name="Text_20_body" style:default-outline-level="1" style:class="text">
   <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
  </style:style>
  <text:outline-style style:name="Outline">
   <text:outline-level-style text:level="1" style:num-format="1" style:num-suffix=".">
    <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
     <style:list-level-label-alignment text:label-followed-by="space"/>
    </style:list-level-properties>
   </text:outline-level-style>
  </text:outline-style>
  <text:list-style style:name="Bullets">
   <text:list-level-style-bullet text:level="1" text:bullet-char="•">
    <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
     <style:list-level-label-alignment text:label-followed-by="listtab" text:list-tab-stop-position="1.27cm" fo:text-indent="-0.635cm" fo:margin-left="1.27cm"/>
    </style:list-level-properties>
   </text:list-level-style-bullet>
  </text:list-style>
  <text:list-style style:name="Numbers">
   <text:list-level-style-number text:level="1" style:num-format="1" style:num-suffix=".">
    <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
     <style:list-level-label-alignment text:label-followed-by="listtab" text:list-tab-stop-position="1.27cm" fo:text-indent="-0.635cm" fo:margin-left="1.27cm"/>
    </style:list-level-properties>
   </text:list-level-style-number>
  </text:list-style>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="PageBreak" style:family="paragraph" style:parent-style-name="Text_20_body">
   <style:paragraph-properties fo:break-before="page"/>
  </style:style>
  <style:style style:name="Sect1" style:family="section">
   <style:section-properties/>
  </style:style>
  <style:style style:name="Tbl" style:family="table">
   <style:table-properties style:width="16cm" table:align="left"/>
  </style:style>
  <style:style style:name="Fr1" style:family="graphic">
   <style:graphic-properties style:wrap="none" style:vertical-pos="top" style:horizontal-pos="center"/>
  </style:style>
 </office:automatic-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Text_20_body">M01 plain alpha</text:p>
   <text:p text:style-name="Text_20_body">M02 plain beta</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">M03 heading gamma</text:h>
   <text:p text:style-name="Text_20_body">M04 body after heading</text:p>
   <text:p text:style-name="Text_20_body">M05 before empty</text:p>
   <text:p text:style-name="Text_20_body"/>
   <text:p text:style-name="Text_20_body">M07 after empty</text:p>
   <text:p text:style-name="Text_20_body">M08 before list</text:p>
   <text:list text:style-name="Bullets">
    <text:list-item><text:p text:style-name="Text_20_body">M09 item one</text:p></text:list-item>
    <text:list-item><text:p text:style-name="Text_20_body">M10 item two</text:p></text:list-item>
   </text:list>
   <text:p text:style-name="Text_20_body">M11 after list</text:p>
   <text:list text:style-name="Numbers">
    <text:list-item><text:p text:style-name="Text_20_body">M12 number one</text:p></text:list-item>
    <text:list-item><text:p text:style-name="Text_20_body">M13 number two</text:p></text:list-item>
   </text:list>
   <text:p text:style-name="Text_20_body">M15 before table</text:p>
   <table:table table:name="T1" table:style-name="Tbl">
    <table:table-column table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p text:style-name="Standard">M17 cell one</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p text:style-name="Standard">M17b cell two</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Text_20_body">M16 after table</text:p>
   <text:p text:style-name="Text_20_body">M19 before anchored</text:p>
   <text:p text:style-name="Text_20_body"><draw:frame draw:style-name="Fr1" draw:name="Anchored" text:anchor-type="paragraph" svg:width="3cm" svg:height="1cm"><draw:text-box><text:p text:style-name="Standard">framebox</text:p></draw:text-box></draw:frame>M20 has anchored frame</text:p>
   <text:p text:style-name="Text_20_body">M21 before break</text:p>
   <text:p text:style-name="PageBreak">M22 after break</text:p>
   <text:p text:style-name="Text_20_body">M23 before section</text:p>
   <text:section text:style-name="Sect1" text:name="S1">
    <text:p text:style-name="Text_20_body">M24 in section</text:p>
   </text:section>
   <text:p text:style-name="Text_20_body">M25 after section</text:p>
   <text:p text:style-name="Text_20_body">M26 line one<text:line-break/>M26 line two</text:p>
   <text:p text:style-name="Text_20_body">M29 last</text:p>
  </office:text>
 </office:body>
</office:document>

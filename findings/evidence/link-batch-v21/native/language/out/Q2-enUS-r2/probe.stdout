args options=Language=en-US
env LANG=en_US.UTF-8
env SAL_USE_VCLPLUGIN=svp
[after-init] glibc setlocale(LC_ALL,NULL)=C
[after-init] cfg System/L10N Locale="en-US" SystemLocale="en-US" UILocale="en-US"
[after-init] cfg Setup/L10N ooSetupSystemLocale="en-US" ooLocale="en-US"
[after-init] cfg Linguistic/General DefaultLocale="" _CJK="" _CTL=""
[after-init] MsLangId configuredSystemLanguage=en-US(0x0409) configuredSystemUILanguage=en-US(0x0409)
[after-init] fallbacks western=en-US(0x0409) asian=zh-CN(0x0804) complex=hi-IN(0x0439)
[after-init] resolve(SYSTEM) latin=en-US(0x0409) asian=zh-CN(0x0804) complex=hi-IN(0x0439)
[after-init] LOK languageTag=zxx locale=zxx
[after-init] PaperInfo::getSystemDefaultPaper paper=8 21590x27940 (1/100 mm)
[after-init] SvtSysLocale languageTag=zxx localeData=en-US currSymbol="$" bank="USD" decimalSep="." dateSep="/" date(2026-10-16)="10/16/2026"
doc type=0
[after-load] glibc setlocale(LC_ALL,NULL)=C
[after-load] cfg System/L10N Locale="en-US" SystemLocale="en-US" UILocale="en-US"
[after-load] cfg Setup/L10N ooSetupSystemLocale="en-US" ooLocale="en-US"
[after-load] cfg Linguistic/General DefaultLocale="" _CJK="" _CTL=""
[after-load] MsLangId configuredSystemLanguage=en-US(0x0409) configuredSystemUILanguage=en-US(0x0409)
[after-load] fallbacks western=en-US(0x0409) asian=zh-CN(0x0804) complex=hi-IN(0x0439)
[after-load] resolve(SYSTEM) latin=en-US(0x0409) asian=zh-CN(0x0804) complex=hi-IN(0x0439)
[after-load] LOK languageTag=en-US locale=en-US
[after-load] PaperInfo::getSystemDefaultPaper paper=8 21590x27940 (1/100 mm)
[after-load] SvtSysLocale languageTag=en-US localeData=en-US currSymbol="$" bank="USD" decimalSep="." dateSep="/" date(2026-10-16)="10/16/2026"

<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:default-outline-level="1">
   <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
  </style:style>
  <text:list-style style:name="LBullet">
   <text:list-level-style-bullet text:level="1" text:bullet-char="•">
    <style:list-level-properties text:list-level-position-and-space-mode="label-alignment">
     <style:list-level-label-alignment text:label-followed-by="listtab" text:list-tab-stop-position="1.27cm" fo:text-indent="-0.635cm" fo:margin-left="1.27cm"/>
    </style:list-level-properties>
   </text:list-level-style-bullet>
  </text:list-style>
 </office:styles>
 <office:body>
  <office:text>
   <text:p>P1 plain paragraph above</text:p>
   <text:p>P2 ALPHA BETA GAMMA DELTA</text:p>
   <text:p>P3 plain paragraph below</text:p>
   <text:p/>
   <text:p>W1 this paragraph is deliberately long so that it wraps onto several displayed lines because it keeps adding ordinary words one after another until the first line is full and then the second line is full as well and a third line is needed to hold the rest of the sentence which goes on for a little while longer before it finally stops here</text:p>
   <text:p>中文段落測試，這是第二句。</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Heading one for the test</text:h>
   <text:list text:style-name="LBullet"><text:list-item><text:p>List item one</text:p></text:list-item></text:list>
   <table:table table:name="T1">
    <table:table-column table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>A1 cell text</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>B1 cell text</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>A2 cell text</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>B2 cell text</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p>Final paragraph ends the document.</text:p>
  </office:text>
 </office:body>
</office:document>

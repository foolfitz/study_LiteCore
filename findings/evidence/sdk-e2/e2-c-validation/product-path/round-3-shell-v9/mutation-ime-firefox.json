      },
      "oracle": "pressing the product's own undo button takes the text the insert button just added back OUT of the document -- read from the saved ODT, not from the revision counter, because D1 covers undo through the shell and this is the button"
    },
    {
      "id": "notice-action-recovers-the-session",
      "ok": true,
      "outcome": "PASS",
      "observed": {
        "stateAfterFailure": "recoverable-error",
        "noticeOffered": {

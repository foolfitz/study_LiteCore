+{
+ "schema": 1,
+ "note": "SPEC-P-ms-formats 5.1 E4, E5: the closed list of replacements taking the frozen ods-editor-v4 worker (dist/profiles/ods-editor-v4/sdk-worker.js) to the ods-editor-v5 worker, applied in order, each occurring exactly once (tools/derive_ms_formats_worker.py).",
+ "hunks": [
+  {
+   "item": "1 header comment",
+   "old": "// SPEC-P-calc-undo 4.2: the ods-editor-v4 worker.  Derived from the frozen\n",
+   "new": "// SPEC-P-ms-formats 5.1: the ods-editor-v5 worker.  The v4 worker plus a closed list\n// (tests/ods-v5-worker-delta.json): the open reply's format, the xlsx gates, this comment.\n//\n// SPEC-P-calc-undo 4.2: the ods-editor-v4 worker.  Derived from the frozen\n"
+  },
+  {
+   "item": "2 the open reply carries the engine's format (E5)",
+   "old": "    ...(typeof event.inputSuffix === \"string\" ? { inputSuffix: event.inputSuffix } : {}),\n",
+   "new": "    ...(typeof event.inputSuffix === \"string\" ? { inputSuffix: event.inputSuffix } : {}),\n    // SPEC-P-ms-formats E5: named, and only when the engine sent it.\n    ...(typeof event.format === \"string\" ? { format: event.format } : {}),\n"
+  },

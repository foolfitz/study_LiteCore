+		--worker $(ODS_EDITOR_V5_BUILD)/sdk-worker.js --exports $(ODS_EDITOR_V5_BUILD)/exports.txt \
+		--base-exports $(ODS_EDITOR_V4_BUILD)/exports.txt --output $(ODS_EDITOR_V5_BUILD)/profile

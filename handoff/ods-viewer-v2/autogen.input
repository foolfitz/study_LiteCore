--host=wasm32-local-emscripten
--disable-gui
--with-wasm-module=writer calc
--with-package-format=emscripten
--enable-cairo-rgba
--with-lang=en-US zh-TW
--disable-debug
--enable-sal-log
--disable-crashdump
--disable-lto
--enable-database-connectivity
--disable-firebird-sdbc
--disable-mariadb-sdbc
--disable-postgresql-sdbc
